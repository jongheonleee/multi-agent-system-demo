# infra/.env.example
#   -> infra/.env 로 복사해서 값을 채운다. docker compose 가 자동으로 읽는다.
#   실제 .env 는 절대 커밋하지 말 것 (.gitignore 로 막혀 있다).
#
# 시크릿 생성:
#   python -c "import secrets; print(secrets.token_hex(16))"   # 32자
#   python -c "import secrets; print(secrets.token_hex(32))"   # 64자 (ENCRYPTION_KEY 전용)

# ── 접속 주소 / 포트 ─────────────────────────────
# 3000 이 다른 컨테이너와 겹치면 아래 포트를 바꾼다.
LANGFUSE_URL=http://localhost:3300
LANGFUSE_PORT=3300
LITELLM_PORT=4000

# ── Langfuse 시크릿 ──────────────────────────────
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=          # 반드시 64자리 hex
NEXTAUTH_SECRET=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
MINIO_PASSWORD=

# ── Langfuse 초기 프로젝트 (첫 기동, 빈 DB 일 때만 적용) ──
# app/.env 의 LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY 와 같은 값을 넣으면
# 같은 키로 프로젝트가 생성되어 앱 설정을 고칠 필요가 없다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ADMIN_EMAIL=admin@local.dev
LANGFUSE_ADMIN_PASSWORD=
# 생략 가능. 비우면 compose 기본값(toyproject / it-agent)이 쓰인다.
#LANGFUSE_INIT_ORG_ID=toyproject
#LANGFUSE_INIT_PROJECT_ID=it-agent

# ── LiteLLM ──────────────────────────────────────
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_UI_PASSWORD=
#LITELLM_UI_USERNAME=admin
#LITELLM_DB_PASSWORD=dbpassword9090

# 업스트림 LLM 키(ANTHROPIC/OPENAI/COHERE)는 여기에 넣지 않는다.
# litellm 서비스가 ../app/.env 를 env_file 로 직접 읽는다.
