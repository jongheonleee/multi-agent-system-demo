# app/.env.example
#   -> app/.env 로 복사해서 값을 채운다.
#   실제 .env 는 절대 커밋하지 말 것 (.gitignore 로 막혀 있다).

# ── LLM / 임베딩 / 리랭커 ────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=              # 임베딩(text-embedding-3-small)용
COHERE_API_KEY=              # 리랭커(rerank-multilingual-v3.0)용

# ── 벡터 DB (Pinecone) ───────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# 인덱스 호스트. 코드에서 Index(host=...) 로 넘긴다(위치 인자로 주면 404).
PINECONE_HOST=

# ── 옵시디언 (Local REST API with MCP 플러그인) ──
# Obsidian 설정 > 커뮤니티 플러그인 > Local REST API with MCP 에서 API 키 복사
OBSIDIAN_MCP_URL=https://127.0.0.1:27124/mcp/
OBSIDIAN_API_KEY=

# ── LiteLLM 게이트웨이 (선택) ────────────────────
# 설정하면 모든 LLM 호출이 게이트웨이를 경유한다. 비우면 Anthropic 에 직접 붙는다.
# LITELLM_API_KEY 는 infra/.env 의 LITELLM_MASTER_KEY 와 같은 값이어야 한다.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=

# ── Langfuse 관측 (선택) ─────────────────────────
# infra 스택의 Langfuse 와 같은 키를 쓴다. 비우면 트레이싱이 꺼진다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3300
LANGFUSE_BASE_URL=http://localhost:3300

# ── LangSmith 관측 (선택) ────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ── 모델 배정 오버라이드 (선택) ──────────────────
AGENT_ORCHESTRATOR_MODEL=claude-opus-5
AGENT_JUDGE_MODEL=claude-opus-5
AGENT_DOMAIN_MODEL=claude-opus-5
AGENT_TREND_MODEL=claude-sonnet-5
SUMMARY_TRIGGER_TOKENS=120000
SUMMARY_KEEP_MESSAGES=40
AGENT_MAX_BUDGET_USD=3           # 턴당 비용 상한(USD). 위임 폭주 방지
